{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":URL:",
              ":BLANK_LINE:",
              [":BUN:", ":NODE:"],
              ":BLANK_LINE:",
              [":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:", "!@/**", "!@taverla/**"],
              ":BLANK_LINE:",
              "@taverla/protocol/**",
              ":BLANK_LINE:",
              "@taverla/core/**",
              ":BLANK_LINE:",
              [":ALIAS:", "@/**", "!@taverla/**"],
              ":BLANK_LINE:",
              [":PATH:", "@/**", "!@taverla/**"]
            ],
            "identifierOrder": "natural"
          }
        },
        "useSortedAttributes": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/*.svg",
      "!.claude/skills",
      "!apps/server/src/infrastructure/questions/question-bank.json"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "single",
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "none"
    }
  },
  "linter": {
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "nursery": {
        "noFloatingPromises": "error"
      },
      "suspicious": {
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["debug", "error", "info", "warn"]
          }
        }
      }
    }
  },
  "vcs": {
    "clientKind": "git",
    "defaultBranch": "main",
    "enabled": true,
    "useIgnoreFile": true
  }
}
