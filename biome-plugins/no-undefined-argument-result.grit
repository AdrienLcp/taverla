language js

or {
  `Result.success($argument)` as $call where {
    $argument <: `undefined`,
    register_diagnostic(span=$call, message="A success that carries nothing is `Result.success()`. Passing `undefined` builds the very same value with the absence spelled out.", severity="error")
  },
  `Result.failure($argument)` as $call where {
    $argument <: `undefined`,
    register_diagnostic(span=$call, message="`Result.failure(undefined)` is a failure whose error *is* `undefined`, not the unknown error. Write `Result.failure()` for that one, or name the error you mean.", severity="error")
  }
}
