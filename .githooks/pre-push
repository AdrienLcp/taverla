#!/usr/bin/env sh
# The same checks as CI, so a red run on main is caught before it is pushed:
# actionlint reads the workflows GitHub would refuse to parse. Skip once with
# `git push --no-verify`.

set -e

if ! command -v actionlint >/dev/null 2>&1; then
  echo "actionlint is missing: winget install rhysd.actionlint" >&2
  exit 1
fi
actionlint

pnpm typecheck
pnpm lint:ci
pnpm build
pnpm test:coverage
pnpm test:e2e
