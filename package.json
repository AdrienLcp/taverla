{
  "author": "Adrien Lacourpaille",
  "devDependencies": {
    "@adrienlcp/biome-config": "^0.1.0",
    "@adrienlcp/tsconfig": "^0.1.0",
    "@biomejs/biome": "2.5.14",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "license": "AGPL-3.0-or-later",
  "name": "taverla",
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "deps:upgrade": "corepack use pnpm@latest && pnpm -r up -L && biome migrate --write",
    "dev": "pnpm --parallel --filter @taverla/server --filter @taverla/game dev",
    "lighthouse": "pnpm build && node scripts/lighthouse.mjs",
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "preinstall": "git config core.hooksPath .githooks || true",
    "test": "pnpm --filter @taverla/protocol --filter @taverla/core --filter @taverla/server test",
    "test:core:watch": "pnpm --filter @taverla/core test:watch",
    "test:e2e": "tsc --noEmit -p e2e && playwright test -c e2e",
    "typecheck": "pnpm -r --parallel exec tsc --noEmit && tsc --noEmit -p e2e",
    "validate": "pnpm build && pnpm test && pnpm test:e2e"
  },
  "type": "module",
  "version": "0.1.0"
}
