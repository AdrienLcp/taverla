{
  "author": "Adrien Lacourpaille",
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.14.0"
  },
  "name": "blindtest",
  "packageManager": "pnpm@11.20.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "deps:upgrade": "pnpm self-update && pnpm -r up -L",
    "dev": "pnpm --parallel --filter @blindtest/server --filter @blindtest/game dev",
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "preinstall": "git config core.hooksPath .githooks || true",
    "test": "pnpm --filter @blindtest/protocol --filter @blindtest/core --filter @blindtest/server test",
    "test:core:watch": "pnpm --filter @blindtest/core test:watch",
    "validate": "pnpm build && pnpm test"
  },
  "type": "module",
  "version": "0.1.0"
}
