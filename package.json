{
  "author": "Adrien Lacourpaille",
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "license": "AGPL-3.0-or-later",
  "name": "taverla",
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "deps:upgrade": "corepack use pnpm@latest && pnpm -r up -L && biome migrate --write",
    "dev": "pnpm --parallel --filter @taverla/server --filter @taverla/game dev",
    "lighthouse": "pnpm build && node scripts/lighthouse.mjs",
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "preinstall": "git config core.hooksPath .githooks || true",
    "test": "pnpm --filter @adrienlcp/i18n --filter @adrienlcp/result --filter @taverla/protocol --filter @taverla/core --filter @taverla/server test",
    "test:core:watch": "pnpm --filter @taverla/core test:watch",
    "test:e2e": "tsc --noEmit -p e2e && playwright test -c e2e",
    "toolkit:check": "node --import tsx scripts/toolkit.ts --check",
    "toolkit:sync": "node --import tsx scripts/toolkit.ts",
    "validate": "pnpm toolkit:check && pnpm build && pnpm test && pnpm test:e2e"
  },
  "type": "module",
  "version": "0.1.0"
}
