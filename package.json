{
  "author": "Adrien Lacourpaille",
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "license": "AGPL-3.0-or-later",
  "name": "taverla",
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "deps:upgrade": "corepack use pnpm@latest && pnpm -r up -L && biome migrate --write",
    "dev": "pnpm --parallel --filter @taverla/server --filter @taverla/game dev",
    "lighthouse": "pnpm build && node scripts/lighthouse.mjs",
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "preinstall": "git config core.hooksPath .githooks || true",
    "test": "pnpm --filter @taverla/protocol --filter @taverla/core --filter @taverla/server test",
    "test:core:watch": "pnpm --filter @taverla/core test:watch",
    "test:e2e": "tsc --noEmit -p e2e && playwright test -c e2e",
    "validate": "pnpm build && pnpm test && pnpm test:e2e"
  },
  "type": "module",
  "version": "0.1.0"
}
