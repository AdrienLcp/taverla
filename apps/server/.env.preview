# Serving the built app from the server is production's shape, not development's
# — the QR code encodes `location.origin`, so both surfaces come from one host.
# This is what lets `pnpm preview` and the Lighthouse run measure the deployment
# rather than a dev server with a proxy in front of it. Same value as
# `render.yaml`, relative to this package because `pnpm --filter` runs from here.
SERVE_GAME_FROM=../game/dist
