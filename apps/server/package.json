{
  "dependencies": {
    "@adrienlcp/result": "^0.1.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@taverla/core": "workspace:*",
    "@taverla/protocol": "workspace:*",
    "hono": "^4.13.10",
    "hono-rate-limiter": "^0.5.4",
    "nanoid": "^6.0.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "description": "Authoritative game server for the blind test",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "5.0.2",
    "hyparquet": "^1.31.2",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2",
    "wrangler": "^4.147.0"
  },
  "name": "@taverla/server",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "dev": "node --watch --import tsx src/index.ts",
    "preview": "node --env-file=.env.preview dist/index.mjs",
    "questions:build": "node --import tsx scripts/build-question-bank.ts",
    "start": "node dist/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest --watch"
  },
  "type": "module",
  "version": "0.1.0"
}
