{
  "$schema": "node_modules/wrangler/config-schema.json",
  "assets": {
    "binding": "ASSETS",
    "directory": "../game/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/robots.txt", "/sitemap.xml"]
  },
  "compatibility_date": "2026-09-01",
  // `process.env` is how `env.ts` reads its variables on both runtimes.
  "compatibility_flags": ["nodejs_compat"],
  // Offset from 8787 like the app from 5173: this repo runs beside the other
  // dev servers on the machine, and Vite proxies `/api` and `/ws` here.
  "dev": {
    "port": 3100
  },
  "durable_objects": {
    "bindings": [
      { "class_name": "RoomObject", "name": "ROOMS" },
      { "class_name": "WallPairingObject", "name": "WALL_PAIRINGS" }
    ]
  },
  "main": "src/worker.ts",
  // The free plan only offers Durable Objects backed by SQLite.
  "migrations": [
    { "new_sqlite_classes": ["RoomObject", "WallPairingObject"], "tag": "v1" }
  ],
  "name": "taverla",
  "observability": { "enabled": true },
  "ratelimits": [
    {
      "name": "ROOM_CREATION_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
